<Window
    x:Class="FluxReader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluxReader"
    xmlns:controls="using:FluxReader.Controls"
    xmlns:models="using:FluxReader.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image
                    x:Name="BrandIcon"
                    Width="24"
                    Height="24">
                    <Image.Source>
                        <SvgImageSource UriSource="ms-appx:///Assets/fluxreader-icon.svg" />
                    </Image.Source>
                </Image>
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="FluxReader" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="AddFeedButton"
                Grid.Column="0"
                Click="AddFeed_Click">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
            </Button>
            <Button
                x:Name="AddGroupButton"
                Grid.Column="1"
                Click="AddGroup_Click">
                <FontIcon FontSize="14" Glyph="&#xE8F4;" />
            </Button>
            <Button
                x:Name="RefreshButton"
                Grid.Column="2"
                Command="{Binding RefreshCommand}">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>

            <ProgressRing
                Grid.Column="4"
                Width="20"
                Height="20"
                Margin="8,0"
                IsActive="{Binding IsBusy}" />
            <Button
                x:Name="SettingsButton"
                Grid.Column="5"
                Click="Settings_Click">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
            <Button
                x:Name="AboutButton"
                Grid.Column="6"
                Click="About_Click">
                <FontIcon FontSize="14" Glyph="&#xE946;" />
            </Button>
        </Grid>

        <Grid
            x:Name="MainContentGrid"
            Grid.Row="2"
            SizeChanged="MainContentGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FeedPaneColumn" Width="248" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="ArticleListPaneColumn" Width="420" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Padding="10,8,10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button
                    Grid.Row="0"
                    HorizontalContentAlignment="Stretch"
                    Click="AllArticles_Click">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="16" Glyph="&#xE8F1;" />
                        <TextBlock x:Name="AllArticlesText" Grid.Column="1" />
                    </Grid>
                </Button>
                <TextBlock
                    x:Name="FeedsHeaderText"
                    Grid.Row="2"
                    Margin="8,0,0,8"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Opacity="0.65" />
                <TreeView
                    x:Name="FeedTree"
                    Grid.Row="3"
                    ItemsSource="{Binding FeedNavigationItems}"
                    SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                    SelectionChanged="FeedTree_SelectionChanged"
                    SelectionMode="Single">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="models:FeedNavigationItem">
                            <TreeViewItem
                                HorizontalContentAlignment="Stretch"
                                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                ItemsSource="{x:Bind Children}">
                                <TreeViewItem.ContextFlyout>
                                    <MenuFlyout Opened="NavigationItemMenu_Opened">
                                        <MenuFlyoutItem
                                            Click="PrimaryNavigationItemMenu_Click"
                                            Text="{x:Bind PrimaryActionText}"
                                            Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="{x:Bind PrimaryActionGlyph}" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Click="RemoveNavigationItemMenu_Click"
                                            Text="{x:Bind RemoveActionText}"
                                            Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </TreeViewItem.ContextFlyout>
                                <TreeViewItem.Content>
                                    <Grid
                                        MinWidth="140"
                                        ColumnSpacing="8"
                                        Tag="{x:Bind}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="16" Height="16">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Glyph="{x:Bind Glyph}"
                                                Visibility="{x:Bind IconFallbackVisibility, Mode=OneWay}" />
                                            <Border CornerRadius="3">
                                                <Image
                                                    Width="16"
                                                    Height="16"
                                                    ImageFailed="FeedIcon_ImageFailed"
                                                    ImageOpened="FeedIcon_ImageOpened"
                                                    Source="{x:Bind IconSource, Mode=OneWay}"
                                                    Stretch="UniformToFill"
                                                    Tag="{x:Bind}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Title, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Opacity="0.65"
                                            Text="{x:Bind UnreadDisplay, Mode=OneWay}" />
                                    </Grid>
                                </TreeViewItem.Content>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <controls:HorizontalResizeSplitter Grid.Column="1">
                <Rectangle
                    Width="1"
                    HorizontalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Thumb
                    x:Name="FeedPaneSplitterThumb"
                    Background="Transparent"
                    DoubleTapped="FeedPaneSplitter_DoubleTapped"
                    DragCompleted="PaneSplitter_DragCompleted"
                    DragDelta="FeedPaneSplitter_DragDelta"
                    IsTabStop="True"
                    KeyDown="FeedPaneSplitter_KeyDown" />
            </controls:HorizontalResizeSplitter>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,12,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Grid Width="24" Height="24">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="20"
                                Glyph="{Binding ArticleListGlyph}"
                                Visibility="{Binding SelectedNavigationItem.IconFallbackVisibility, Mode=OneWay, TargetNullValue=Visible}" />
                            <Border CornerRadius="4">
                                <Image
                                    Width="24"
                                    Height="24"
                                    ImageFailed="FeedIcon_ImageFailed"
                                    ImageOpened="FeedIcon_ImageOpened"
                                    Source="{Binding SelectedNavigationItem.IconSource}"
                                    Stretch="UniformToFill"
                                    Tag="{Binding SelectedNavigationItem}" />
                            </Border>
                        </Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="{Binding ArticleListTitle}" />
                    </StackPanel>
                    <Button
                        x:Name="MarkCurrentListReadButton"
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Margin="8,0"
                        Padding="0"
                        Command="{Binding MarkCurrentListReadCommand}">
                        <FontIcon FontSize="14" Glyph="&#xE73E;" />
                    </Button>
                    <ToggleButton
                        x:Name="UnreadFilterToggleButton"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="UnreadFilterToggle_Click"
                        IsChecked="{Binding IsUnreadFilterEnabled, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="&#xE8C3;" />
                    </ToggleButton>
                    <TextBlock
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Opacity="0.6"
                        Text="{Binding ArticleCountText}" />
                </Grid>
                <ListView
                    x:Name="ArticleList"
                    Grid.Row="1"
                    IsItemClickEnabled="True"
                    ItemClick="ArticleList_ItemClick"
                    ItemsSource="{Binding Articles}"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Article">
                            <Grid Padding="14,12" ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{x:Bind UnreadGlyph, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        MaxLines="2"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Opacity="0.65"
                                        Text="{x:Bind FeedTitle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        MaxLines="2"
                                        Opacity="0.6"
                                        Text="{x:Bind Summary}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="5">
                                    <TextBlock
                                        FontSize="11"
                                        Opacity="0.55"
                                        Text="{x:Bind PublishedDisplay}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <controls:HorizontalResizeSplitter Grid.Column="3">
                <Rectangle
                    Width="1"
                    HorizontalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Thumb
                    x:Name="ArticleListPaneSplitterThumb"
                    Background="Transparent"
                    DoubleTapped="ArticleListPaneSplitter_DoubleTapped"
                    DragCompleted="PaneSplitter_DragCompleted"
                    DragDelta="ArticleListPaneSplitter_DragDelta"
                    IsTabStop="True"
                    KeyDown="ArticleListPaneSplitter_KeyDown" />
            </controls:HorizontalResizeSplitter>

            <Grid Grid.Column="4" Padding="28,18,28,24">
                <Grid x:Name="ArticleEmptyView">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <FontIcon FontSize="48" Glyph="&#xE8A5;" Opacity="0.3" />
                        <TextBlock
                            x:Name="EmptyArticleTitleText"
                            FontSize="20"
                            FontWeight="SemiBold"
                            TextAlignment="Center" />
                        <TextBlock
                            x:Name="EmptyArticleDescriptionText"
                            Opacity="0.6"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ArticleReaderView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        MaxLines="4"
                        Text="{Binding SelectedArticle.Title}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        Opacity="0.6"
                        Text="{Binding SelectedArticle.Byline}"
                        TextWrapping="Wrap" />
                    <StackPanel Grid.Row="2" Margin="0,16,0,16" Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding OpenArticleCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="OpenInBrowserText" />
                                <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="MarkUnreadButton"
                            Command="{Binding MarkSelectedArticleUnreadCommand}"
                            IsEnabled="{Binding SelectedArticle.IsRead}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="MarkUnreadText" />
                                <FontIcon FontSize="12" Glyph="&#xE8C3;" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                            FontSize="16"
                            IsTextSelectionEnabled="True"
                            LineHeight="26"
                            Text="{Binding SelectedArticle.DisplayContent}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <InfoBar
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
            Message="{Binding StatusMessage}"
            Severity="Informational" />

        <Frame
            x:Name="SettingsFrame"
            Grid.Row="1"
            Grid.RowSpan="2"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Visibility="Collapsed" />
    </Grid>
</Window>
