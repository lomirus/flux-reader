<Window
    x:Class="FluxReader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluxReader"
    xmlns:controls="using:FluxReader.Controls"
    xmlns:models="using:FluxReader.Models"
    xmlns:viewModels="using:FluxReader.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <x:Double x:Key="FeedNavigationRowHeight">32</x:Double>

            <DataTemplate
                x:Key="StatusNotificationDetailTemplate"
                x:DataType="viewModels:StatusNotificationDetail">
                <StackPanel Padding="0,8" Spacing="2">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind Title}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Opacity="0.75"
                        Text="{x:Bind Description}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate
                x:Key="FeedNavigationItemContentTemplate"
                x:DataType="models:FeedNavigationItem">
                <Grid
                    Background="Transparent"
                    MinWidth="140"
                    ColumnSpacing="8"
                    Padding="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="16" Height="16">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Glyph="{x:Bind Glyph}"
                            Visibility="{x:Bind IconFallbackVisibility, Mode=OneWay}" />
                        <Border CornerRadius="3">
                            <Image
                                Width="16"
                                Height="16"
                                ImageFailed="FeedIcon_ImageFailed"
                                ImageOpened="FeedIcon_ImageOpened"
                                Source="{x:Bind IconSource, Mode=OneWay}"
                                Stretch="Uniform"
                                Tag="{x:Bind}" />
                        </Border>
                    </Grid>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind RefreshWarningToolTip, Mode=OneWay}"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Text="&#xE7BA;"
                        ToolTipService.ToolTip="{x:Bind RefreshWarningToolTip, Mode=OneWay}"
                        Visibility="{x:Bind RefreshWarningVisibility, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Opacity="0.65"
                        Text="{x:Bind UnreadDisplay, Mode=OneWay}" />
                </Grid>
            </DataTemplate>

            <Style
                x:Key="FeedNavigationListItemStyle"
                BasedOn="{StaticResource DefaultListViewItemStyle}"
                TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="MinHeight" Value="{StaticResource FeedNavigationRowHeight}" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Default InfoBarCloseButtonStyle is top-aligned and inherits ButtonPadding (11,5,11,6), which shifts the glyph up on compact toasts. -->
            <Style
                x:Key="StatusInfoBarCloseButtonStyle"
                BasedOn="{StaticResource InfoBarCloseButtonStyle}"
                TargetType="Button">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image
                    x:Name="BrandIcon"
                    Width="24"
                    Height="24">
                    <Image.Source>
                        <SvgImageSource UriSource="ms-appx:///Assets/fluxreader-icon.svg" />
                    </Image.Source>
                </Image>
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="FluxReader" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="AddFeedButton"
                Grid.Column="0"
                Click="AddFeed_Click">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
            </Button>
            <Button
                x:Name="AddGroupButton"
                Grid.Column="1"
                Click="AddGroup_Click">
                <FontIcon FontSize="14" Glyph="&#xE8F4;" />
            </Button>
            <Button
                x:Name="RefreshButton"
                Grid.Column="2"
                Command="{Binding RefreshCommand}">
                <FontIcon
                    x:Name="RefreshIcon"
                    FontSize="14"
                    Glyph="&#xE72C;"
                    RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <RotateTransform x:Name="RefreshIconRotation" />
                    </FontIcon.RenderTransform>
                </FontIcon>
            </Button>

            <Button
                x:Name="SettingsButton"
                Grid.Column="4"
                Click="Settings_Click">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
            <Button
                x:Name="AboutButton"
                Grid.Column="5"
                Click="About_Click">
                <FontIcon FontSize="14" Glyph="&#xE946;" />
            </Button>
        </Grid>

        <Grid
            x:Name="MainContentGrid"
            Grid.Row="2"
            SizeChanged="MainContentGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FeedPaneColumn" Width="248" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="ArticleListPaneColumn" Width="420" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Padding="10,8,10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button
                    Grid.Row="0"
                    HorizontalContentAlignment="Stretch"
                    Click="AllArticles_Click">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="16" Glyph="&#xE8F1;" />
                        <TextBlock x:Name="AllArticlesText" Grid.Column="1" />
                    </Grid>
                </Button>
                <TextBlock
                    x:Name="FeedsHeaderText"
                    Grid.Row="2"
                    Margin="8,0,0,8"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Opacity="0.65" />
                <ListView
                    x:Name="FeedList"
                    Grid.Row="3"
                    ContainerContentChanging="FeedList_ContainerContentChanging"
                    IsMultiSelectCheckBoxEnabled="False"
                    ItemContainerStyle="{StaticResource FeedNavigationListItemStyle}"
                    ItemsSource="{Binding FeedNavigationRows}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionChanged="FeedList_SelectionChanged"
                    SelectionMode="Extended">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:FeedNavigationItem">
                            <Grid
                                Padding="4,3,0,5"
                                Background="Transparent"
                                Tag="{x:Bind}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind NavigationIndent}" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.ContextFlyout>
                                    <MenuFlyout Opened="NavigationItemMenu_Opened">
                                        <MenuFlyoutItem
                                            Click="RefreshNavigationFeedMenu_Click"
                                            Text="{x:Bind RefreshActionText}"
                                            Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE72C;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Click="EditNavigationFeedMenu_Click"
                                            Text="{x:Bind EditActionText}"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind FeedActionVisibility}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Click="PrimaryNavigationItemMenu_Click"
                                            Text="{x:Bind PrimaryActionText}"
                                            Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="{x:Bind PrimaryActionGlyph}" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Click="RemoveNavigationItemMenu_Click"
                                            Text="{x:Bind RemoveActionText}"
                                            Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Button
                                    x:Name="ExpandCollapseChevron"
                                    Grid.Column="1"
                                    Width="32"
                                    Height="20"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="FeedGroupChevron_Click"
                                    Tag="{x:Bind}"
                                    Visibility="{x:Bind ChevronVisibility}">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                    </Button.Resources>
                                    <FontIcon FontSize="14" Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" />
                                </Button>
                                <ContentControl
                                    Grid.Column="2"
                                    Content="{x:Bind}"
                                    ContentTemplate="{StaticResource FeedNavigationItemContentTemplate}"
                                    HorizontalContentAlignment="Stretch"
                                    IsTabStop="False" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <controls:HorizontalResizeSplitter Grid.Column="1">
                <Rectangle
                    Width="1"
                    HorizontalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Thumb
                    x:Name="FeedPaneSplitterThumb"
                    Background="Transparent"
                    DoubleTapped="FeedPaneSplitter_DoubleTapped"
                    DragCompleted="PaneSplitter_DragCompleted"
                    DragDelta="FeedPaneSplitter_DragDelta"
                    IsTabStop="True"
                    KeyDown="FeedPaneSplitter_KeyDown" />
            </controls:HorizontalResizeSplitter>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,12,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Grid Width="24" Height="24">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="20"
                                Glyph="{Binding ArticleListGlyph}"
                                Visibility="{Binding SelectedNavigationItem.IconFallbackVisibility, Mode=OneWay, TargetNullValue=Visible}" />
                            <Border CornerRadius="4">
                                <Image
                                    Width="24"
                                    Height="24"
                                    ImageFailed="FeedIcon_ImageFailed"
                                    ImageOpened="FeedIcon_ImageOpened"
                                    Source="{Binding SelectedNavigationItem.IconSource, FallbackValue={x:Null}, TargetNullValue={x:Null}}"
                                    Stretch="Uniform"
                                    Tag="{Binding SelectedNavigationItem}" />
                            </Border>
                        </Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="{Binding ArticleListTitle}" />
                    </StackPanel>
                    <Button
                        x:Name="MarkCurrentListReadButton"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Margin="8,0"
                        Padding="0"
                        Command="{Binding MarkCurrentListReadCommand}">
                        <FontIcon FontSize="14" Glyph="&#xE73E;" />
                    </Button>
                    <ToggleButton
                        x:Name="UnreadFilterToggleButton"
                        Grid.Column="3"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="UnreadFilterToggle_Click"
                        IsChecked="{Binding IsUnreadFilterEnabled, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="&#xE8C3;" />
                    </ToggleButton>
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Opacity="0.6"
                        Text="{Binding ArticleCountText}" />
                    <AutoSuggestBox
                        x:Name="ArticleSearchBox"
                        Grid.Row="1"
                        Grid.ColumnSpan="4"
                        Margin="0,8,0,0"
                        QueryIcon="Find"
                        TextChanged="ArticleSearchBox_TextChanged" />
                </Grid>
                <ListView
                    x:Name="ArticleList"
                    Grid.Row="1"
                    IsItemClickEnabled="True"
                    ItemClick="ArticleList_ItemClick"
                    ItemsSource="{Binding Articles}"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Article">
                            <Grid Padding="14,12" ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{x:Bind UnreadGlyph, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontWeight="SemiBold"
                                    MaxLines="2"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    FontSize="11"
                                    Opacity="0.55"
                                    Text="{x:Bind PublishedDisplay}" />
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,4,0,0"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Visibility="{x:Bind FeedTitleVisibility}">
                                    <Grid Width="14" Height="14">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Glyph="{x:Bind FeedNavigationItem.Glyph}"
                                            Visibility="{x:Bind FeedNavigationItem.IconFallbackVisibility, Mode=OneWay}" />
                                        <Border CornerRadius="2">
                                            <Image
                                                Width="14"
                                                Height="14"
                                                ImageFailed="FeedIcon_ImageFailed"
                                                ImageOpened="FeedIcon_ImageOpened"
                                                Source="{x:Bind FeedNavigationItem.IconSource, Mode=OneWay}"
                                                Stretch="Uniform"
                                                Tag="{x:Bind FeedNavigationItem}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        FontSize="12"
                                        Opacity="0.65"
                                        Text="{x:Bind FeedTitle}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    MaxLines="2"
                                    Opacity="0.6"
                                    Text="{x:Bind ListPreview}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <controls:HorizontalResizeSplitter Grid.Column="3">
                <Rectangle
                    Width="1"
                    HorizontalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Thumb
                    x:Name="ArticleListPaneSplitterThumb"
                    Background="Transparent"
                    DoubleTapped="ArticleListPaneSplitter_DoubleTapped"
                    DragCompleted="PaneSplitter_DragCompleted"
                    DragDelta="ArticleListPaneSplitter_DragDelta"
                    IsTabStop="True"
                    KeyDown="ArticleListPaneSplitter_KeyDown" />
            </controls:HorizontalResizeSplitter>

            <Grid Grid.Column="4" Padding="28,18,28,24">
                <Grid x:Name="ArticleEmptyView">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <FontIcon FontSize="48" Glyph="&#xE8A5;" Opacity="0.3" />
                        <TextBlock
                            x:Name="EmptyArticleTitleText"
                            FontSize="20"
                            FontWeight="SemiBold"
                            TextAlignment="Center" />
                        <TextBlock
                            x:Name="EmptyArticleDescriptionText"
                            Opacity="0.6"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ArticleReaderView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Width="40"
                            Height="40"
                            Margin="0,2,0,0"
                            VerticalAlignment="Top">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="30"
                                Glyph="{Binding SelectedArticleNavigationItem.Glyph}"
                                Visibility="{Binding SelectedArticleNavigationItem.IconFallbackVisibility, Mode=OneWay, TargetNullValue=Visible}" />
                            <Border CornerRadius="6">
                                <Image
                                    Width="40"
                                    Height="40"
                                    ImageFailed="FeedIcon_ImageFailed"
                                    ImageOpened="FeedIcon_ImageOpened"
                                    Source="{Binding SelectedArticleNavigationItem.IconSource, FallbackValue={x:Null}, TargetNullValue={x:Null}}"
                                    Stretch="Uniform"
                                    Tag="{Binding SelectedArticleNavigationItem}" />
                            </Border>
                        </Grid>
                        <TextBlock
                            Grid.Column="1"
                            FontSize="30"
                            FontWeight="SemiBold"
                            IsTextSelectionEnabled="True"
                            MaxLines="4"
                            Text="{Binding SelectedArticle.Title}"
                            TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        Opacity="0.6"
                        Text="{Binding SelectedArticle.Byline}"
                        TextWrapping="Wrap" />
                    <StackPanel Grid.Row="2" Margin="0,16,0,16" Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding OpenArticleCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="OpenInBrowserText" />
                                <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="MarkUnreadButton"
                            Command="{Binding MarkSelectedArticleUnreadCommand}"
                            IsEnabled="{Binding SelectedArticle.IsRead}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="MarkUnreadText" />
                                <FontIcon FontSize="12" Glyph="&#xE8C3;" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Grid Grid.Row="3">
                        <WebView2
                            x:Name="ArticleWebView"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                        <Grid
                            x:Name="ArticleLoadingView"
                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            Visibility="Collapsed">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                                <ProgressRing
                                    x:Name="ArticleLoadingProgressRing"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Center"
                                    IsActive="False" />
                                <TextBlock
                                    x:Name="ArticleLoadingText"
                                    HorizontalAlignment="Center"
                                    Opacity="0.65" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            CloseButtonStyle="{StaticResource StatusInfoBarCloseButtonStyle}"
            IsClosable="True"
            MaxWidth="720" />

        <Frame
            x:Name="SettingsFrame"
            Grid.Row="1"
            Grid.RowSpan="2"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Visibility="Collapsed" />
    </Grid>
</Window>
