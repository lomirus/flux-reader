<Page
    x:Class="FluxReader.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Height="48" Padding="16,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Width="32"
                Height="32"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.Name="返回"
                Background="Transparent"
                BorderThickness="0"
                Click="BackButton_Click"
                ToolTipService.ToolTip="返回">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Text="设置" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="760"
                Margin="32,24,32,40"
                HorizontalAlignment="Center"
                Spacing="12">
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="外观" />

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="应用主题" />
                            <TextBlock
                                MaxWidth="460"
                                Opacity="0.65"
                                Text="选择 FluxReader 使用的颜色模式。跟随系统会随 Windows 设置自动切换。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            x:Name="ThemeSelector"
                            Grid.Column="1"
                            MinWidth="128"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="应用主题"
                            SelectionChanged="ThemeSelector_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="亮色" />
                            <ComboBoxItem Content="暗色" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
