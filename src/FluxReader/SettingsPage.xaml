<Page
    x:Class="FluxReader.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Height="48" Padding="16,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                Width="32"
                Height="32"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="BackButton_Click">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                x:Name="SettingsTitleText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="760"
                Margin="32,24,32,40"
                HorizontalAlignment="Center"
                Spacing="12">
                <TextBlock
                    x:Name="AppearanceHeaderText"
                    FontSize="14"
                    FontWeight="SemiBold" />

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="ThemeTitleText" FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="ThemeDescriptionText"
                                HorizontalAlignment="Left"
                                MaxWidth="460"
                                Opacity="0.65"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            x:Name="ThemeSelector"
                            Grid.Column="1"
                            MinWidth="128"
                            VerticalAlignment="Center"
                            SelectionChanged="ThemeSelector_SelectionChanged">
                            <ComboBoxItem x:Name="SystemThemeItem" />
                            <ComboBoxItem x:Name="LightThemeItem" />
                            <ComboBoxItem x:Name="DarkThemeItem" />
                        </ComboBox>
                    </Grid>
                </Border>

                <TextBlock
                    x:Name="LanguageHeaderText"
                    Margin="0,12,0,0"
                    FontSize="14"
                    FontWeight="SemiBold" />

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="LanguageTitleText" FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="LanguageDescriptionText"
                                HorizontalAlignment="Left"
                                MaxWidth="460"
                                Opacity="0.65"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            x:Name="LanguageSelector"
                            Grid.Column="1"
                            MinWidth="220"
                            VerticalAlignment="Center"
                            SelectionChanged="LanguageSelector_SelectionChanged">
                            <ComboBoxItem Content="简体中文" />
                            <ComboBoxItem Content="繁體中文" />
                            <ComboBoxItem Content="English" />
                            <ComboBoxItem Content="Français" />
                            <ComboBoxItem Content="Deutsch" />
                            <ComboBoxItem Content="Italiano" />
                            <ComboBoxItem Content="Español (España)" />
                            <ComboBoxItem Content="Español (Latinoamérica)" />
                            <ComboBoxItem Content="Português (Brasil)" />
                            <ComboBoxItem Content="Polski" />
                            <ComboBoxItem Content="Русский" />
                            <ComboBoxItem Content="日本語" />
                            <ComboBoxItem Content="한국어" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
